                  : ''
              }
            </article>
          `;
        })
        .join('');
    }

    // =========================================================================
    // 8. TAB 3 RENDERING: 4–6/HR PACE & 10-MINUTE RHYTHM TIMER
    // =========================================================================
    function formatMMSS(totalSec) {
      const mins = Math.floor(totalSec / 60);
      const secs = totalSec % 60;
      return `${String(mins).padStart(2, '0')}:${String(secs).padStart(2, '0')}`;
    }

    function updateRhythmTimerUI() {
      const clockEl = document.getElementById('rhythm-clock-display');
      const elapsedEl = document.getElementById('rhythm-elapsed-display');
      const labelEl = document.getElementById('rhythm-active-label');
      const startBtn = document.getElementById('rhythm-start-btn');

      const left = state.rhythmSecondsLeft;
      const elapsed = 600 - left;

      if (clockEl) {
        clockEl.textContent = left === 0 ? '00:00' : formatMMSS(left);
        clockEl.classList.toggle('urgent', left <= 120);
      }

      if (elapsedEl) {
        const eMin = Math.floor(elapsed / 60);
        const eSec = elapsed % 60;
        elapsedEl.textContent = `${eMin}:${String(eSec).padStart(2, '0')} / 10:00`;
      }

      if (startBtn) {
        startBtn.textContent = state.rhythmTimerRunning ? '⏸ Pause Timer' : '▶ Start 10:00';
      }

      // Highlight which phase of the 10-minute cycle we are in:
      // 0:00-2:00 (0-119s) Scout, 2:00-5:00 (120-299s) Walk & Guide,
      // 5:00-7:00 (300-419s) Speed-Dial Handoff, 7:00-10:00 (420-600s) Reset & Reposition
      let activePhase = 1;
      let phaseText = 'Phase 1 (0:00–2:00): Scout & Engage';
      if (elapsed >= 420) {
        activePhase = 4;
        phaseText = 'Phase 4 (7:00–10:00): Reset & Reposition';
      } else if (elapsed >= 300) {
        activePhase = 3;
        phaseText = 'Phase 3 (5:00–7:00): Speed-Dial Handoff';
      } else if (elapsed >= 120) {
        activePhase = 2;
        phaseText = 'Phase 2 (2:00–5:00): Walk & Guide';
      }

      if (labelEl) {
        labelEl.textContent = left === 0 ? '⏰ 10:00 Cycle Complete — Log Transfer or Reset!' : phaseText;
      }

      [1, 2, 3, 4].forEach((idx) => {
        const pill = document.getElementById(`rhythm-pill-${idx}`);
        if (pill) pill.classList.toggle('current', idx === activePhase);
      });
    }

    function toggleRhythmTimer() {
      if (state.rhythmTimerRunning) {
        state.rhythmTimerRunning = false;
        clearInterval(rhythmInterval);
        updateRhythmTimerUI();
        return;
      }

      if (state.rhythmSecondsLeft <= 0) {
        state.rhythmSecondsLeft = 600;
      }

      state.rhythmTimerRunning = true;
      updateRhythmTimerUI();
      clearInterval(rhythmInterval);
      rhythmInterval = setInterval(() => {
        if (state.rhythmSecondsLeft > 0) {
          state.rhythmSecondsLeft -= 1;
          persistState();
          updateRhythmTimerUI();
        } else {
          state.rhythmTimerRunning = false;
          clearInterval(rhythmInterval);
          updateRhythmTimerUI();
        }
      }, 1000);
    }

    function resetRhythmTimer() {
      state.rhythmTimerRunning = false;
      clearInterval(rhythmInterval);
      state.rhythmSecondsLeft = 600;
      persistState();
      updateRhythmTimerUI();
    }

    function logTransferAndReset() {
      state.pace.transfers += 1;
      state.rhythmSecondsLeft = 600;
      persistState();
      updateHeaderTransferPill();
      updateRhythmTimerUI();
      renderPaceArea();
      showToast(`📞 Transfer #${state.pace.transfers} logged! 10:00 clock reset!`);
    }

    function updatePace(key, delta) {
      state.pace[key] = Math.max(0, (state.pace[key] || 0) + delta);
      state.paceResetConfirm = false;
      persistState();
      updateHeaderTransferPill();
      renderPaceArea();
    }

    function handlePaceReset() {
      const btn = document.getElementById('pace-reset-btn');
      if (!state.paceResetConfirm) {
        state.paceResetConfirm = true;
        if (btn) {
          btn.textContent = 'Tap Again to Confirm';
          btn.style.backgroundColor = 'var(--red)';
          btn.style.color = 'var(--white)';
        }
        clearTimeout(window._paceResetTimer);
        window._paceResetTimer = setTimeout(() => {
          state.paceResetConfirm = false;
          renderPaceArea();
        }, 3200);
        return;
      }
      state.pace = { greetings: 0, homeowners: 0, transfers: 0 };
      state.paceResetConfirm = false;
      persistState();
      updateHeaderTransferPill();
      renderPaceArea();
    }

    function selectZone(zoneId) {
      state.activeZone = zoneId;
      persistState();
      renderPaceArea();
    }

    function renderPaceArea() {
      const resetBtn = document.getElementById('pace-reset-btn');
      if (resetBtn && !state.paceResetConfirm) {
        resetBtn.textContent = 'Reset Hour';
        resetBtn.style.backgroundColor = '';
        resetBtn.style.color = '';
      }

      const { greetings, homeowners, transfers } = state.pace;
      const alertBox = document.getElementById('pace-coaching-alert');

      if (alertBox) {
        if (greetings >= 8 && transfers === 0) {
          alertBox.innerHTML = `
            <div class="coaching-alert-red flash-red-alert" role="alert">
              🚨 STOP CHATTING WITHOUT DIALING! Hit Speed Dial within 2 seconds of hearing Homeowner — 4 to 6 transfers/hr is mandatory!
            </div>
          `;
        } else if (transfers >= 6) {
          alertBox.innerHTML = `
            <div class="coaching-alert-gold">
