    function loadPersistedState() {
      try {
        if (typeof window === 'undefined' || !window.localStorage) return;
        const raw = window.localStorage.getItem(STORAGE_KEY);
        if (!raw) return;
        const saved = JSON.parse(raw);
        if (!saved || typeof saved !== 'object') return;
        if (typeof saved.repName === 'string' && saved.repName.trim()) state.repName = saved.repName;
        if (typeof saved.storeNum === 'string' && saved.storeNum.trim()) state.storeNum = saved.storeNum;
        if (typeof saved.deskName === 'string' && saved.deskName.trim()) state.deskName = saved.deskName;
        if (saved.pace && typeof saved.pace === 'object') {
          state.pace = {
            greetings: Math.max(0, Number(saved.pace.greetings) || 0),
            homeowners: Math.max(0, Number(saved.pace.homeowners) || 0),
            transfers: Math.max(0, Number(saved.pace.transfers) || 0)
          };
        }
        if (typeof saved.activeZone === 'string') state.activeZone = saved.activeZone;
        if (typeof saved.rhythmSecondsLeft === 'number' && saved.rhythmSecondsLeft >= 0 && saved.rhythmSecondsLeft <= 600) {
          state.rhythmSecondsLeft = saved.rhythmSecondsLeft;
        }
      } catch (e) {
        // Ignore storage restrictions
      }
    }

    function persistState() {
      try {
        if (typeof window === 'undefined' || !window.localStorage) return;
        window.localStorage.setItem(
          STORAGE_KEY,
          JSON.stringify({
            repName: state.repName,
            storeNum: state.storeNum,
            deskName: state.deskName,
            pace: state.pace,
            activeZone: state.activeZone,
            rhythmSecondsLeft: state.rhythmSecondsLeft
          })
        );
      } catch (e) {
        // Ignore storage restrictions
      }
    }

