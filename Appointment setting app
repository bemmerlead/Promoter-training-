<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Contest Transfer Coach: 4–6 Calls/Hr Field Weapon</title>
  <style>
    /* =========================================================================
       DESIGN TOKENS & MOBILE-FIRST RESET (ZERO EXTERNAL LIBRARIES OR CDNS)
       ========================================================================= */
    :root {
      --navy: #0F172A;
      --navy-mid: #1E293B;
      --navy-soft: #334155;
      --orange: #EA580C;
      --orange-dark: #C2410C;
      --orange-tint: #FFF7ED;
      --orange-border: #FDBA74;
      --red: #DC2626;
      --red-dark: #991B1B;
      --red-tint: #FEF2F2;
      --red-border: #FCA5A5;
      --green: #16A34A;
      --green-dark: #15803D;
      --green-tint: #F0FDF4;
      --green-border: #86EFAC;
      --gold-bg: #FEF3C7;
      --gold-border: #F59E0B;
      --gold-text: #78350F;
      --blue-tint: #EFF6FF;
      --blue-border: #93C5FD;
      --blue-text: #1E3A8A;
      --white: #FFFFFF;
      --bg: #F8FAFC;
      --slate-100: #F1F5F9;
      --slate-200: #E2E8F0;
      --slate-300: #CBD5E1;
      --slate-600: #475569;
      --slate-700: #334155;
      --radius-lg: 16px;
      --radius-md: 12px;
      --radius-sm: 8px;
      --shadow-sm: 0 1px 3px rgba(15, 23, 42, 0.08);
      --shadow-md: 0 4px 14px rgba(15, 23, 42, 0.16);
    }

    *, *::before, *::after {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    html, body {
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
      background-color: var(--bg);
      color: var(--navy);
      font-size: 16px;
      line-height: 1.48;
      -webkit-tap-highlight-color: transparent;
      overflow-x: hidden;
    }

    button, input {
      font-family: inherit;
    }

    /* Minimum 48px thumb-friendly touch target across all interactive buttons */
    button {
      min-height: 48px;
      cursor: pointer;
      border: none;
      border-radius: var(--radius-md);
      font-weight: 800;
      transition: transform 0.1s ease, background-color 0.15s ease, box-shadow 0.15s ease;
    }

    button:active {
      transform: scale(0.98);
    }

    .hidden {
      display: none !important;
    }

    @keyframes pulseRedAlert {
      0%, 100% {
        box-shadow: 0 0 0 0 rgba(220, 38, 38, 0.72);
        transform: scale(1);
      }
      50% {
        box-shadow: 0 0 0 8px rgba(220, 38, 38, 0);
        transform: scale(1.01);
      }
    }

    .flash-red-alert {
      animation: pulseRedAlert 1.4s infinite;
    }

    /* =========================================================================
       PERSISTENT STICKY TOP HEADER & 4-TAB NAVIGATION
       ========================================================================= */
    .app-header {
      position: sticky;
      top: 0;
      z-index: 50;
      background-color: var(--navy);
      color: var(--white);
      box-shadow: var(--shadow-md);
      border-bottom: 3px solid var(--orange);
    }

    .header-inner {
      max-width: 780px;
      margin: 0 auto;
      padding: 10px 12px 12px;
    }

    .header-top {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 8px;
      margin-bottom: 10px;
      flex-wrap: wrap;
    }

    .brand-block {
      display: flex;
      align-items: center;
      gap: 10px;
      min-width: 0;
      flex: 1 1 240px;
    }

    .brand-icon {
      width: 44px;
      height: 44px;
      border-radius: 10px;
      background-color: var(--orange);
      color: var(--white);
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 22px;
      flex-shrink: 0;
    }

    .brand-title {
      font-size: 16px;
      font-weight: 900;
      line-height: 1.18;
      color: var(--white);
    }

    .target-badge {
      display: inline-block;
      margin-top: 4px;
      padding: 3px 9px;
      border-radius: 6px;
      background-color: var(--green);
      color: var(--white);
      font-size: 11px;
      font-weight: 900;
      letter-spacing: 0.04em;
    }

    .transfer-pill-btn {
      background-color: var(--navy-mid);
      color: var(--white);
      border: 2px solid var(--green);
      padding: 8px 13px;
      font-size: 14px;
      font-weight: 900;
      border-radius: 999px;
      display: inline-flex;
      align-items: center;
      gap: 6px;
      flex-shrink: 0;
      font-variant-numeric: tabular-nums;
      box-shadow: 0 2px 8px rgba(22, 163, 74, 0.35);
    }

    .transfer-pill-btn.elite {
      background-color: var(--gold-bg);
      color: var(--gold-text);
      border-color: var(--gold-border);
    }

    .nav-grid {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 6px;
    }

    @media (min-width: 620px) {
      .nav-grid {
        grid-template-columns: repeat(4, 1fr);
      }
      .brand-title {
        font-size: 17px;
      }
    }

    .nav-tab {
      background-color: var(--navy-mid);
      color: #E2E8F0;
      border: 2px solid #334155;
      padding: 8px 6px;
      font-size: 13px;
      line-height: 1.2;
      text-align: center;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .nav-tab.active {
      background-color: var(--orange);
      color: var(--white);
      border-color: #FED7AA;
      box-shadow: 0 2px 8px rgba(234, 88, 12, 0.45);
    }

    /* =========================================================================
       LAYOUT CONTAINER, CARDS & BADGES
       ========================================================================= */
    .main-container {
      max-width: 780px;
      margin: 0 auto;
      padding: 16px 12px 84px;
    }

    .section-stack {
      display: flex;
      flex-direction: column;
      gap: 14px;
    }

    .card {
      background-color: var(--white);
      border-radius: var(--radius-lg);
      border: 2px solid var(--slate-200);
      padding: 16px;
      box-shadow: var(--shadow-sm);
    }

    .card-navy { border-color: var(--navy); }
    .card-orange { border-color: var(--orange); }
    .card-red { border-color: var(--red); }
    .card-green { border-color: var(--green); }

    .badge {
      display: inline-flex;
      align-items: center;
      gap: 4px;
      padding: 4px 10px;
      border-radius: 6px;
      font-size: 11px;
      font-weight: 900;
      letter-spacing: 0.04em;
      text-transform: uppercase;
    }

    .badge-orange { background-color: var(--orange); color: var(--white); }
    .badge-navy { background-color: var(--navy); color: var(--white); }
    .badge-red { background-color: var(--red); color: var(--white); }
    .badge-green { background-color: var(--green); color: var(--white); }
    .badge-amber { background-color: #FEF3C7; color: #92400E; border: 1px solid #F59E0B; }
    .badge-blue { background-color: #DBEAFE; color: #1E3A8A; border: 1px solid #60A5FA; }

    /* =========================================================================
       TAB 1: WALK & TALK SCRIPT TELEPROMPTER
       ========================================================================= */
    .zero-friction-banner {
      background-color: var(--red);
      color: var(--white);
      border: 3px solid #7F1D1D;
      border-radius: var(--radius-lg);
      padding: 14px 16px;
      font-size: 15px;
      font-weight: 900;
      line-height: 1.44;
      box-shadow: var(--shadow-sm);
    }

    .personalizer-grid {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 10px;
    }

    @media (min-width: 600px) {
      .personalizer-grid {
        grid-template-columns: repeat(4, 1fr);
      }
    }

    .field-label {
      display: block;
      font-size: 11px;
      font-weight: 900;
      text-transform: uppercase;
      color: var(--navy-soft);
      margin-bottom: 4px;
      letter-spacing: 0.03em;
    }

    .text-input {
      width: 100%;
      min-height: 48px;
      padding: 10px 12px;
      border-radius: var(--radius-md);
      border: 2px solid var(--slate-300);
      background-color: var(--bg);
      color: var(--navy);
      font-size: 16px;
      font-weight: 800;
    }

    .text-input:focus {
      outline: none;
      border-color: var(--orange);
      background-color: var(--white);
    }

    .mode-switch-row {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 8px;
    }

    .mode-btn {
      background-color: var(--white);
      color: var(--navy);
      border: 2px solid var(--slate-300);
      font-size: 14px;
      padding: 10px;
    }

    .mode-btn.active {
      background-color: var(--navy);
      color: var(--white);
      border-color: var(--navy);
    }

    .step-dots {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 6px;
      margin-bottom: 12px;
    }

    .step-dot-btn {
      min-height: 48px;
      padding: 6px 4px;
      font-size: 13px;
      font-weight: 900;
      background-color: var(--slate-200);
      color: var(--navy);
      border: 2px solid transparent;
    }

    .step-dot-btn.active {
      background-color: var(--orange);
      color: var(--white);
      border-color: var(--navy);
    }

    .action-cue-box {
      background-color: var(--gold-bg);
      border: 2px solid var(--gold-border);
      color: var(--gold-text);
      border-radius: var(--radius-md);
      padding: 12px;
      font-size: 15px;
      font-weight: 800;
      margin-bottom: 12px;
    }

    .script-speech-box {
      background-color: var(--bg);
      border-left: 5px solid var(--orange);
      border-radius: var(--radius-md);
      padding: 14px;
      font-size: 17px;
      font-weight: 800;
      color: var(--navy);
      line-height: 1.52;
      margin-bottom: 12px;
    }

    .focus-speech {
      font-size: 19px;
      line-height: 1.54;
    }

    .handoff-subbox {
      background-color: var(--white);
      border: 2px solid var(--slate-300);
      border-radius: var(--radius-md);
      padding: 12px;
      margin-top: 10px;
    }

    .handoff-subbox.customer-box {
      background-color: var(--green-tint);
      border-color: var(--green);
    }

    .name-token {
      background-color: #FFEDD5;
      color: var(--orange-dark);
      padding: 1px 6px;
      border-radius: 5px;
      border: 1px solid var(--orange-border);
    }

    .branch-toggle-row {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 8px;
      margin: 10px 0 12px;
    }

    .branch-btn {
      background-color: var(--white);
      color: var(--navy);
      border: 2px solid var(--slate-300);
      font-size: 15px;
      padding: 10px 8px;
    }

    .branch-btn.active-home {
      background-color: var(--green);
      color: var(--white);
      border-color: var(--green-dark);
    }

    .branch-btn.active-rent {
      background-color: var(--navy);
      color: var(--white);
      border-color: var(--navy);
    }

    .branch-response {
      border-radius: var(--radius-md);
      padding: 14px;
      font-size: 17px;
      font-weight: 800;
      margin-bottom: 12px;
      line-height: 1.48;
    }

    .branch-response.home {
      background-color: var(--green-tint);
      border: 2px solid var(--green);
      color: #14532D;
    }

    .branch-response.rent {
      background-color: var(--blue-tint);
      border: 2px solid #2563EB;
      color: var(--blue-text);
    }

    .escalate-btn {
      width: 100%;
      min-height: 56px;
      background-color: var(--orange);
      color: var(--white);
      font-size: 16px;
      font-weight: 900;
      padding: 14px 16px;
      box-shadow: 0 4px 10px rgba(234, 88, 12, 0.35);
    }

    .escalate-btn:hover {
      background-color: var(--orange-dark);
    }

    .escalate-btn.final-call {
      background-color: var(--green);
      box-shadow: 0 4px 10px rgba(22, 163, 74, 0.35);
    }

    .focus-nav-secondary {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 8px;
      margin-top: 10px;
    }

    .btn-secondary {
      background-color: var(--slate-200);
      color: var(--navy);
      font-size: 14px;
      padding: 10px 12px;
    }

    /* 10-Minute Rhythm Card */
    .rhythm-card {
      background-color: var(--navy);
      color: var(--white);
      border: 3px solid var(--orange);
      border-radius: var(--radius-lg);
      padding: 16px;
    }

    .rhythm-grid {
      display: grid;
      grid-template-columns: 1fr;
      gap: 8px;
      margin-top: 12px;
    }

    @media (min-width: 580px) {
      .rhythm-grid {
        grid-template-columns: repeat(2, 1fr);
      }
    }

    .rhythm-slot {
      background-color: var(--navy-mid);
      border: 2px solid #334155;
      border-left: 5px solid var(--orange);
      border-radius: var(--radius-md);
      padding: 12px;
    }

    .rhythm-slot.handoff {
      border-left-color: var(--green);
      background-color: #132A20;
    }

    .rhythm-time {
      font-size: 12px;
      font-weight: 900;
      color: #FDBA74;
      letter-spacing: 0.04em;
    }

    .rhythm-slot.handoff .rhythm-time {
      color: #86EFAC;
    }

    /* =========================================================================
       TAB 2: OBJECTIONS & REBUTTALS (18)
       ========================================================================= */
    .search-wrapper {
      position: relative;
      display: flex;
      align-items: center;
      margin-bottom: 12px;
    }

    .search-input {
      width: 100%;
      min-height: 52px;
      padding: 12px 52px 12px 14px;
      border-radius: var(--radius-md);
      border: 2px solid var(--navy);
      font-size: 16px;
      font-weight: 700;
      color: var(--navy);
      background-color: var(--white);
    }

    .search-input:focus {
      outline: none;
      border-color: var(--orange);
    }

    .clear-search {
      position: absolute;
      right: 4px;
      min-height: 44px;
      width: 44px;
      background-color: var(--slate-200);
      color: var(--navy);
      font-size: 16px;
      border-radius: 8px;
    }

    .filter-chips {
      display: flex;
      flex-wrap: wrap;
      gap: 8px;
    }

    .chip-btn {
      background-color: var(--white);
      color: var(--navy);
      border: 2px solid var(--slate-300);
      padding: 8px 12px;
      font-size: 13px;
      font-weight: 800;
    }

    .chip-btn.active {
      background-color: var(--navy);
      color: var(--white);
      border-color: var(--navy);
    }

    .obj-card {
      background-color: var(--white);
      border-radius: var(--radius-lg);
      border: 2px solid var(--slate-300);
      overflow: hidden;
      box-shadow: var(--shadow-sm);
    }

    .obj-card.priority-card {
      border-color: var(--orange);
    }

    .obj-header-btn {
      width: 100%;
      background-color: transparent;
      color: var(--navy);
      padding: 14px 16px;
      text-align: left;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
      border-radius: 0;
    }

    .obj-header-btn:hover {
      background-color: var(--bg);
    }

    .obj-title {
      font-size: 17px;
      font-weight: 900;
      color: var(--navy);
      margin-top: 5px;
      line-height: 1.32;
    }

    .obj-sub {
      font-size: 14px;
      font-weight: 600;
      color: var(--slate-600);
      margin-top: 3px;
    }

    .obj-chevron {
      width: 40px;
      height: 40px;
      border-radius: 10px;
      background-color: var(--slate-100);
      color: var(--navy);
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 14px;
      flex-shrink: 0;
    }

    .obj-card.open .obj-chevron {
      background-color: var(--navy);
      color: var(--white);
      transform: rotate(180deg);
    }

    .obj-body {
      padding: 14px 16px 16px;
      border-top: 2px solid var(--slate-200);
      display: flex;
      flex-direction: column;
      gap: 10px;
      background-color: var(--bg);
    }

    .store-toggle-box {
      background-color: var(--white);
      border: 2px solid var(--orange);
      border-radius: var(--radius-md);
      padding: 10px;
    }

    .store-toggle-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 8px;
      margin-top: 6px;
    }

    .store-mode-btn {
      background-color: var(--slate-100);
      color: var(--navy);
      border: 2px solid var(--slate-300);
      padding: 8px 10px;
      font-size: 13px;
      line-height: 1.25;
    }

    .store-mode-btn.active {
      background-color: var(--orange);
      color: var(--white);
      border-color: var(--orange-dark);
    }

    .step-box {
      border-radius: var(--radius-md);
      padding: 12px;
    }

    .step-box-1 {
      background-color: var(--gold-bg);
      border-left: 5px solid #F59E0B;
    }

    .step-box-2 {
      background-color: var(--white);
      border: 2px solid var(--slate-200);
      border-left: 5px solid var(--navy);
    }

    .step-box-3 {
      background-color: var(--green-tint);
      border: 2px solid var(--green);
    }

    .step-box-label {
      font-size: 11px;
      font-weight: 900;
      text-transform: uppercase;
      letter-spacing: 0.05em;
      margin-bottom: 4px;
    }

    .step-box-1 .step-box-label { color: #B45309; }
    .step-box-2 .step-box-label { color: var(--navy); }
    .step-box-3 .step-box-label { color: var(--green-dark); }

    .step-box-text {
      font-size: 16px;
      font-weight: 800;
      color: var(--navy);
      line-height: 1.45;
    }

    .body-tone-box {
      background-color: var(--blue-tint);
      border: 2px solid var(--blue-border);
      border-radius: var(--radius-md);
      padding: 11px 12px;
      font-size: 14px;
      font-weight: 700;
      color: var(--blue-text);
    }

    .copy-script-btn {
      background-color: var(--navy);
      color: var(--white);
      font-size: 15px;
      padding: 10px 16px;
      align-self: flex-start;
    }

    /* =========================================================================
       TAB 3: 4–6/HR PACE & 10-MINUTE RHYTHM TIMER
       ========================================================================= */
    .rhythm-timer-hero {
      background-color: var(--navy);
      color: var(--white);
      border: 3px solid var(--orange);
      border-radius: var(--radius-lg);
      padding: 16px;
    }

    .timer-display-row {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
      margin: 10px 0 12px;
      flex-wrap: wrap;
    }

    .big-clock {
      font-size: 46px;
      font-weight: 900;
      color: #FDBA74;
      line-height: 1;
      font-variant-numeric: tabular-nums;
    }

    .big-clock.urgent {
      color: #FCA5A5;
    }

    .timer-phases-strip {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 8px;
      margin-bottom: 14px;
    }

    @media (min-width: 580px) {
      .timer-phases-strip {
        grid-template-columns: repeat(4, 1fr);
      }
    }

    .timer-phase-pill {
      background-color: var(--navy-mid);
      border: 2px solid #334155;
      border-radius: var(--radius-md);
      padding: 9px 10px;
      opacity: 0.65;
      transition: all 0.15s ease;
    }

    .timer-phase-pill.current {
      opacity: 1;
      background-color: var(--orange);
      border-color: var(--white);
      transform: translateY(-1px);
      box-shadow: 0 3px 10px rgba(234, 88, 12, 0.45);
    }

    .timer-phase-pill.current.handoff-phase {
      background-color: var(--green);
    }

    .timer-controls-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 8px;
    }

    .logged-transfer-btn {
      grid-column: span 2;
      min-height: 58px;
      background-color: var(--green);
      color: var(--white);
      font-size: 17px;
      font-weight: 900;
      border: 2px solid var(--green-border);
      box-shadow: 0 4px 12px rgba(22, 163, 74, 0.4);
    }

    .logged-transfer-btn:hover {
      background-color: var(--green-dark);
    }

    .counter-card {
      background-color: var(--bg);
      border: 2px solid var(--slate-300);
      border-radius: var(--radius-md);
      padding: 14px;
    }

    .counter-card.goal-met {
      border-color: var(--green);
      background-color: var(--green-tint);
    }

    .counter-top {
      display: flex;
      align-items: center;
      justify-content: space-between;
      margin-bottom: 8px;
    }

    .counter-num {
      font-size: 32px;
      font-weight: 900;
      color: var(--navy);
      font-variant-numeric: tabular-nums;
    }

    .progress-track {
      width: 100%;
      height: 12px;
      background-color: var(--slate-200);
      border-radius: 999px;
      overflow: hidden;
      margin-bottom: 12px;
    }

    .progress-fill {
      height: 100%;
      background-color: var(--orange);
      transition: width 0.2s ease;
    }

    .progress-fill.green {
      background-color: var(--green);
    }

    .counter-btns {
      display: grid;
      grid-template-columns: 1fr 2fr;
      gap: 8px;
    }

    .btn-minus {
      background-color: var(--white);
      border: 2px solid var(--slate-300);
      color: var(--navy);
      font-size: 20px;
    }

    .btn-plus {
      background-color: var(--orange);
      color: var(--white);
