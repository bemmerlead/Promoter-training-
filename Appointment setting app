    function completeScriptTransfer() {
      state.pace.transfers += 1;
      state.rhythmSecondsLeft = 600;
      state.focusStep = 1;
      persistState();
      updateHeaderTransferPill();
      renderScriptArea();
      renderPaceArea();
      showToast(`📞 Transfer #${state.pace.transfers} logged! Timer reset to 10:00`);
    }

    // =========================================================================
    // 7. TAB 2 RENDERING: OBJECTIONS & REBUTTALS (18)
    // =========================================================================
    function handleObjSearch(val) {
      state.objSearch = val.trim().toLowerCase();
      const clearBtn = document.getElementById('obj-clear-btn');
      if (clearBtn) clearBtn.classList.toggle('hidden', state.objSearch.length === 0);
      renderObjectionsArea();
    }

    function clearObjSearch() {
      const inp = document.getElementById('obj-search-input');
      if (inp) {
        inp.value = '';
        handleObjSearch('');
        inp.focus();
      }
    }

    function setObjCategory(cat) {
      state.objCategory = cat;
      document.querySelectorAll('.chip-btn').forEach((btn) => {
        btn.classList.toggle('active', btn.getAttribute('data-cat') === cat);
      });
      renderObjectionsArea();
    }

    function toggleObjection(id) {
      state.openObjIds[id] = !state.openObjIds[id];
      renderObjectionsArea();
    }

    function copyRebuttal(id) {
      const item = OBJECTIONS.find((o) => o.id === id);
      if (!item) return;
      const fullText = `${item.step1} ${item.step2} ${item.step3}`;
      try {
        const ta = document.createElement('textarea');
        ta.value = fullText;
        ta.setAttribute('readonly', '');
        ta.style.position = 'fixed';
        ta.style.left = '-9999px';
        document.body.appendChild(ta);
        ta.select();
        document.execCommand('copy');
        document.body.removeChild(ta);
        showToast('✅ Script copied to clipboard!');
      } catch (e) {
        showToast('✅ Script ready to read!');
      }
    }

    function renderObjectionsArea() {
      const area = document.getElementById('objections-render-area');
      if (!area) return;
      const query = state.objSearch;

      const filtered = OBJECTIONS.filter((item) => {
        if (!query && state.objCategory !== 'all') {
          if (!item.cats.includes(state.objCategory)) return false;
        }
        if (!query) return true;
        const haystack = `${item.trigger} ${item.sub} ${item.step1} ${item.step2} ${item.step3} ${item.tip}`.toLowerCase();
        return haystack.includes(query);
      });

      if (filtered.length === 0) {
        area.innerHTML = `
          <div class="card" style="text-align:center;">
            <p style="font-size:17px; font-weight:900; margin-bottom:6px;">No matching objection found</p>
            <p style="font-size:15px; color:var(--slate-600); margin-bottom:12px;">
