            </p>
            <button type="button" class="escalate-btn" style="min-height:48px;" onclick="clearObjSearch(); setObjCategory('all');">
              Show All 18 Objections
            </button>
          </div>
        `;
        return;
      }

      area.innerHTML = filtered
        .map((item) => {
          const isOpen = !!state.openObjIds[item.id] || query.length > 0;
          return `
            <article class="obj-card ${item.priority ? 'priority-card' : ''} ${isOpen ? 'open' : ''}">
              <button
                type="button"
                class="obj-header-btn"
                onclick="toggleObjection(${item.id})"
                aria-expanded="${isOpen}"
              >
                <div>
                  <div style="display:flex; gap:6px; flex-wrap:wrap; align-items:center;">
                    <span style="font-size:12px; font-weight:900; color:var(--slate-600);">#${item.id}</span>
                    <span class="badge ${item.badgeClass}">${item.badgeText}</span>
                  </div>
                  <div class="obj-title">${item.trigger}</div>
                  <div class="obj-sub">${item.sub}</div>
                </div>
                <span class="obj-chevron" aria-hidden="true">▼</span>
              </button>

              ${
                isOpen
                  ? `<div class="obj-body">
                       <div class="step-box step-box-1">
                         <div class="step-box-label">1. Acknowledge &amp; Disarm</div>
                         <div class="step-box-text">${item.step1}</div>
                       </div>

                       <div class="step-box step-box-2">
                         <div class="step-box-label">2. Reframe / Time Anchor</div>
                         <div class="step-box-text">${item.step2}</div>
                       </div>

                       <div class="step-box step-box-3">
                         <div class="step-box-label">3. Speed-Dial Pivot</div>
                         <div class="step-box-text">${item.step3}</div>
                       </div>

                       <div class="body-tone-box">
                         🎯 ${item.tip}
                       </div>

                       <button type="button" class="copy-script-btn" onclick="copyRebuttal(${item.id})">
                         📋 Copy Script
                       </button>
