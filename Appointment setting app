            </div>
          `;
        } else if (transfers >= 4) {
          alertBox.innerHTML = `
            <div class="coaching-alert-green">
              ✅ MINIMUM TARGET HIT — Push for 6/hr! (${transfers} of 6 Transfers Completed)
            </div>
          `;
        } else {
          const needed = 4 - transfers;
          alertBox.innerHTML = `
            <div style="background-color:var(--navy); color:var(--white); border-radius:12px; padding:12px 14px; font-size:15px; font-weight:800; border-left:5px solid var(--orange);">
              Mandatory Target: <strong>4 to 6 Live Transfers / Hr</strong>. You need <strong>${needed} more transfer${needed === 1 ? '' : 's'}</strong> this hour to hit minimum standard!
            </div>
          `;
        }
      }

      const defs = [
        {
          key: 'greetings',
          title: 'Shoppers Greeted / Helped',
          goal: 25,
          goalText: 'Target: 20–30 / hr (Aisle Concierge)',
          isMoney: false
        },
        {
          key: 'homeowners',
          title: 'Homeowners Qualified',
          goal: 10,
          goalText: 'Target: 8–12 / hr (First Name + Homeowner)',
          isMoney: false
        },
        {
          key: 'transfers',
          title: 'Live Contest Transfers Completed',
          goal: 6,
          goalText: 'Mandatory Target: 4 to 6 / hr',
          isMoney: true
        }
      ];

      const countersArea = document.getElementById('pace-counters-area');
      if (countersArea) {
        countersArea.innerHTML = defs
          .map((d) => {
            const val = state.pace[d.key];
            const pct = Math.min(100, Math.round((val / d.goal) * 100));
            const met = d.key === 'transfers' ? val >= 4 : val >= d.goal;
            return `
              <div class="counter-card ${met ? 'goal-met' : ''}">
                <div class="counter-top">
                  <div>
                    <div style="font-size:16px; font-weight:900; color:var(--navy);">${d.title}</div>
                    <div style="font-size:13px; font-weight:800; color:${met ? 'var(--green-dark)' : 'var(--slate-600)'};">
                      ${d.goalText} ${met ? '✅ ON PACE!' : ''}
                    </div>
                  </div>
                  <div class="counter-num">${val}</div>
                </div>
                <div class="progress-track">
                  <div class="progress-fill ${met || d.isMoney ? 'green' : ''}" style="width:${pct}%"></div>
                </div>
                <div class="counter-btns">
                  <button type="button" class="btn-minus" onclick="updatePace('${d.key}', -1)" aria-label="Minus 1 ${d.title}">
                    −1
                  </button>
                  <button type="button" class="btn-plus ${d.isMoney ? 'green' : ''}" onclick="updatePace('${d.key}', 1)">
                    +1 Tap
                  </button>
                </div>
              </div>
            `;
          })
          .join('');
      }

      const zoneGrid = document.getElementById('zone-grid-area');
      if (zoneGrid) {
        zoneGrid.innerHTML = AISLE_ZONES.map(
          (z) => `
            <button
              type="button"
              class="zone-btn ${state.activeZone === z.id ? 'active' : ''}"
              onclick="selectZone('${z.id}')"
            >
              <div style="font-weight:900; color:${state.activeZone === z.id ? '#FDBA74' : 'var(--navy)'};">
                ${state.activeZone === z.id ? '📍 ' : ''}${z.title}
              </div>
              <div style="font-size:13px; font-weight:600; margin-top:3px; color:${state.activeZone === z.id ? '#E2E8F0' : 'var(--slate-600)'};">
                ${z.desc}
              </div>
            </button>
          `
        ).join('');
      }

      updateRhythmTimerUI();
    }

    // =========================================================================
    // 9. TAB 4 RENDERING: 8-ROUND SPEED-DIAL DRILL SIMULATOR
    // =========================================================================
    function pickDrillChoice(choiceId) {
      if (state.drillChoice !== null) return;
      const sc = DRILL_SCENARIOS[state.drillIdx];
      const chosen = sc.choices.find((c) => c.id === choiceId);
      if (!chosen) return;
      state.drillChoice = choiceId;
      if (chosen.correct) state.drillScore += 1;
      renderDrillArea();
    }

    function nextDrillRound() {
      if (state.drillIdx + 1 >= DRILL_SCENARIOS.length) {
        state.drillDone = true;
      } else {
        state.drillIdx += 1;
        state.drillChoice = null;
      }
      renderDrillArea();
    }

    function restartDrill() {
      state.drillIdx = 0;
      state.drillChoice = null;
      state.drillScore = 0;
      state.drillDone = false;
      renderDrillArea();
    }

    function renderDrillArea() {
      const pill = document.getElementById('drill-score-pill');
      if (pill) pill.textContent = `Score: ${state.drillScore} / ${DRILL_SCENARIOS.length}`;

      const area = document.getElementById('drill-render-area');
      if (!area) return;

      if (state.drillDone) {
        const passed = state.drillScore >= 7;
        area.innerHTML = `
          <div style="margin-top:14px; padding:18px; border-radius:14px; background-color:${
            passed ? 'var(--green-tint)' : 'var(--red-tint)'
          }; border:2px solid ${passed ? 'var(--green)' : 'var(--red)'}; text-align:center;">
            <span class="badge ${passed ? 'badge-green' : 'badge-red'}" style="margin-bottom:8px;">
              ${passed ? '🏆 SPEED-DIAL CERTIFIED (4–6 CALLS/HR READY)' : '⚠️ NEEDS REPS — LOCK IN THE 2-SEC SPEED DIAL'}
            </span>
            <div style="font-size:38px; font-weight:900; color:var(--navy); margin:4px 0;">
              ${state.drillScore} / ${DRILL_SCENARIOS.length}
            </div>
            <p style="font-size:16px; font-weight:800; color:var(--navy); margin-bottom:14px;">
              ${
                passed
                  ? 'You mastered the Aisle Concierge opener, Zero-Data-in-Aisle rule, 2-second Speed Dial, Renter QR vs. Homeowner branching, and 15-second warm handoff!'
                  : 'Review the Walk & Talk Script and 18 Objections, then run this 8-round drill again until you score at least 7/8.'
              }
            </p>
            <button type="button" class="escalate-btn" onclick="restartDrill()">
              🔄 Run 8-Round Speed-Dial Drill Again
            </button>
          </div>
        `;
        return;
      }

      const sc = DRILL_SCENARIOS[state.drillIdx];
      const chosenObj = state.drillChoice ? sc.choices.find((c) => c.id === state.drillChoice) : null;

      area.innerHTML = `
        <div style="margin-top:12px;">
          <div style="display:flex; align-items:center; justify-content:space-between; gap:8px; flex-wrap:wrap;">
            <span class="badge badge-navy">Round ${sc.round} of ${DRILL_SCENARIOS.length}</span>
            <span style="font-size:12px; font-weight:900; color:var(--orange);">${sc.badge}</span>
          </div>

          <div class="drill-scenario-box">
            <div style="font-size:12px; font-weight:800; color:#94A3B8; text-transform:uppercase; margin-bottom:4px;">
              Live Aisle Scenario:
            </div>
            <div style="font-size:17px; font-weight:800; line-height:1.45;">
              ${sc.situation}
            </div>
          </div>

          <div class="section-stack">
            ${sc.choices
              .map((c) => {
                let cls = 'drill-choice-btn';
                let icon = c.id.toUpperCase() + '. ';
                if (chosenObj) {
                  if (c.correct) {
                    cls += ' correct';
                    icon = '✅ ';
                  } else if (c.id === chosenObj.id) {
                    cls += ' wrong';
                    icon = '❌ ';
                  } else {
                    cls += ' dimmed';
                  }
                }
                return `
                  <button
                    type="button"
                    class="${cls}"
                    ${chosenObj ? 'disabled' : ''}
                    onclick="pickDrillChoice('${c.id}')"
                  >
                    ${icon}${c.text}
                  </button>
                `;
              })
              .join('')}
          </div>

          ${
            chosenObj
              ? `<div class="feedback-box ${chosenObj.correct ? 'ok' : 'bad'}">
                   <div style="font-size:16px; font-weight:900; margin-bottom:4px;">
                     ${chosenObj.correct ? '✅ HITS 4–6 CALLS/HR PACE!' : '❌ SLOWS DOWN YOUR TRANSFER PACE!'}
                   </div>
                   <div style="margin-bottom:12px;">${chosenObj.why}</div>
                   <button type="button" class="escalate-btn" style="min-height:50px;" onclick="nextDrillRound()">
                     ${state.drillIdx + 1 >= DRILL_SCENARIOS.length ? 'See Certification Score 🏆' : 'Next Round →'}
                   </button>
                 </div>`
              : ''
          }
        </div>
      `;
    }

    // =========================================================================
    // 10. IMMEDIATE INITIALIZATION
    // =========================================================================
    function initApp() {
      if (appInitialized) return;
      appInitialized = true;

      try {
        loadPersistedState();
